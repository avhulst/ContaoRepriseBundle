{
    "$schema": "vendor/infection/infection/resources/schema.json",
    "source": {
        "directories": ["src"]
    },
    "logs": {
        "text": "var/infection/infection.log",
        "summary": "var/infection/summary.log"
    },
    "tmpDir": "var/infection/tmp",
    "mutators": {
        "@default": true,
        // Equivalent mutant: Bundle::build() is empty; the call is kept as the Symfony convention.
        "MethodCallRemoval": {
            "ignore": ["Trassd\\ContaoRepriseBundle\\ContaoRepriseBundle::build"]
        }
    },
    "minMsi": 100,
    "minCoveredMsi": 100
}
