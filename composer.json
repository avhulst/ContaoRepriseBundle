{
    "name": "trassd/contao-reprise-bundle",
    "description": "Integrates symfony/reprise (Vite/Rsbuild) into Contao: select entrypoints per page layout.",
    "license": "MIT",
    "type": "contao-bundle",
    "keywords": [
        "contao",
        "vite",
        "rsbuild",
        "reprise",
        "assets"
    ],
    "require": {
        "php": "^8.4",
        "contao/core-bundle": "^5.7",
        "psr/log": "^1.1 || ^2.0 || ^3.0",
        "symfony/config": "^7.4 || ^8.0",
        "symfony/dependency-injection": "^7.4 || ^8.0",
        "symfony/http-kernel": "^7.4 || ^8.0",
        "symfony/reprise": "^1.3"
    },
    "require-dev": {
        "contao/easy-coding-standard": "^6.14 || ^7.0",
        "contao/manager-plugin": "^2.0",
        "contao/test-case": "^5.7",
        "phpstan/phpstan": "^2.2",
        "phpstan/phpstan-phpunit": "^2.0",
        "phpstan/phpstan-symfony": "^2.0",
        "phpunit/phpunit": "^12.4",
        "symfony/asset": "^7.4 || ^8.0",
        "symfony/http-foundation": "^7.4 || ^8.0",
        "infection/infection": "^0.35"
    },
    "conflict": {
        "contao/manager-plugin": "<2.0 || >=3.0"
    },
    "autoload": {
        "psr-4": {
            "Trassd\\ContaoRepriseBundle\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Trassd\\ContaoRepriseBundle\\Tests\\": "tests/"
        }
    },
    "config": {
        "allow-plugins": {
            "contao-community-alliance/composer-plugin": true,
            "contao-components/installer": true,
            "contao/manager-plugin": true,
            "dealerdirect/phpcodesniffer-composer-installer": false,
            "php-http/discovery": false,
            "infection/extension-installer": true
        }
    },
    "extra": {
        "contao-manager-plugin": "Trassd\\ContaoRepriseBundle\\ContaoManager\\Plugin"
    },
    "scripts": {
        "ecs": "@php vendor/bin/ecs check --fix",
        "phpstan": "@php vendor/bin/phpstan analyze",
        "unit-tests": "@php vendor/bin/phpunit",
        "mutation": "@php vendor/bin/infection --threads=max --show-mutations --no-progress --initial-tests-php-options=\"-d zend_extension=xdebug.so -d xdebug.mode=coverage -d opcache.jit=disable\"",
        "all": [
            "@ecs",
            "@phpstan",
            "@unit-tests",
            "@mutation"
        ]
    }
}
